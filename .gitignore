# =============================================================================
# ASD Detection — .gitignore
# CRITICAL: Model weights and trained artifacts are intentionally excluded.
# See README.md — "Model Weights" section for access instructions.
# =============================================================================

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Virtual environments ──────────────────────────────────────────────────────
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.conda/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ── !! MODEL WEIGHTS — DO NOT UPLOAD !! ──────────────────────────────────────
# These patterns prevent accidental upload of trained artifacts.
# Weights are available upon request for research collaboration (see README).
models/
artifacts/
weights/
checkpoints/
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.pt
*.pth
*.pb
*.onnx
*.bin
*.safetensors
saved_model/
model_card_override.json

# ── Data — raw full dataset (only sample is public) ──────────────────────────
data/raw/*.csv
data/raw/*.arff
data/raw/*.xlsx
data/processed/*.csv
data/processed/*.parquet
# Exception: sample data is allowed
!data/sample/*.csv
!data/sample/README.md

# ── Reports and generated outputs ────────────────────────────────────────────
reports/
outputs/
*.png
*.jpg
*.jpeg
*.pdf
!docs/architecture.png
!docs/banner.png

# ── Secrets & credentials ─────────────────────────────────────────────────────
.env
.env.*
secrets.yaml
secrets.json
config/local_*.yaml
*.pem
*.key

# ── OS artifacts ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# ── Testing & coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage.xml
*.cover

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
